--- a/core/eklog.c
+++ b/core/eklog.c
@@ -0,0 +1,13 @@
+/* Eternal Kombat research: a log of what the game does with the Sega CD's
+   PCM chip and CD-DA, for tools/mksound_measure.py (opened by retro_ek_log). */
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdarg.h>
+long long ek_pcm_ticks = 0, ek_frame = 0;
+static FILE *ek_fp = NULL;
+int ek_on(void) { return ek_fp != NULL; }
+void ek_printf(const char *fmt, ...) { va_list ap; if (!ek_fp) return; va_start(ap, fmt); vfprintf(ek_fp, fmt, ap); va_end(ap); }
+void ek_flush(void) { if (ek_fp) fflush(ek_fp); }
+/* path: start logging there; NULL: stop */
+void retro_ek_log(const char *path) { if (ek_fp) fclose(ek_fp); ek_fp = path ? fopen(path, "w") : NULL; }
+void retro_ek_mark(const char *t) { if (ek_fp) { fprintf(ek_fp, "M %lld %s\n", ek_frame, t); fflush(ek_fp); } }
